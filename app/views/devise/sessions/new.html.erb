<div class="min-h-[calc(100vh-6rem)] flex justify-center items-center -translate-y-1">
  <div class="bg-white max-w-2xl min-w-sm mx-auto p-4">

    <h2 class="text-2xl text-center mb-4">ログイン</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field mb-4">
        <p><%= f.label :email %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border border-gray-300 rounded p-1 w-full" %></p>
      </div>

      <div class="field mb-4">
        <p><%= f.label :password %></p>
        <p><%= f.password_field :password, autocomplete: "current-password", class: "border border-gray-300 rounded p-1 w-full" %></p>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field flex items-center gap-2 mb-4">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me %>
        </div>
      <% end %>

      <div class="actions mb-4 bg-cyan-500">
        <%= f.submit "ログイン", class: "w-full cursor-pointer text-center text-white font-bold py-4 rounded" %>
      </div>
    <% end %>

    <div class="text-center border border-gray-300 rounded py-4 w-full">
      <%= render "devise/shared/links" %>
    </div>
  </div>

</div>
