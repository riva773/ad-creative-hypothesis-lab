<main class="flex min-h-[calc(100vh-5rem)] items-center justify-center py-12">
  <section class="w-[430px] rounded-2xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-950/5">
    <div class="mb-7">
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">ログイン</h1>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field mb-5">
        <%= f.label :email, class: "text-sm font-semibold text-slate-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/15" %>
      </div>

      <div class="field mb-6">
        <%= f.label :password, class: "text-sm font-semibold text-slate-700" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/15" %>
      </div>

      <div class="actions">
        <%= f.submit "ログイン", class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/30" %>
      </div>
    <% end %>

    <div class="mt-6 border-t border-slate-200 pt-5 text-center text-sm text-slate-600">
      <%= render "devise/shared/links" %>
    </div>
  </section>
</main>
