<div class="border border-gray-300 rounded-xl col-span-1 pb-4">
  <%= link_to app_path(app) do %>
    <div class="w-full aspect-square overflow-hidden rounded-xl" >
      <% if app.avatar.attached? %>
        <%= image_tag app.avatar, class: "pb-2 rounded object-cover w-full h-full", alt: "アプリアイコン" %>
      <% else %>
        <%= image_tag "sample_app_logo.png", class: "pb-2 rounded object-cover w-full h-full", alt: "アプリアイコン" %>
      <% end %>
    </div>
    <div class="px-4">
      <p class="font-bold"><%= app.name %></p>
    </div>
  <% end %>
  <% if app.user_id === current_user.id %>
    <div data-controller="app-menu" class="flex flex-col items-end">
      <button class="p-2 text-gray-500 hover:text-gray-700 rounded-full hover:bg-gray-100 transition-colors cursor-pointer" data-action="click->app-menu#toggle">
    <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5?" />
    </svg>
      </button>
      <div data-app-menu-target="modal" class="hidden">
        <div class="bg-gray-100 rounded inline-block text-center p-2">
          <div data-controller="app-destroy">
            <button class="border-b border-gray-300 text-red-500 cursor-pointer" type="button" data-action="click->app-destroy#open">アプリを削除</button>
            <div data-app-destroy-target="modal" class="hidden fixed justify-center items-center z-50 inset-0 bg-black/50">
              <div class="bg-white p-8 rounded-xl min-w-md">
                <%= form_with model: app, method: :delete do |f| %>
                  <div class="flex flex-col">
                    <h1 class="text-2xl font-bold mb-4">アプリを削除</h1>
                    <%= image_tag app.avatar, class:"w-32 h-32 object-cover mx-auto" %>
                    <p><%= app.name %></p>
                    <p><%= app.explanation %></p>
                    <div class="mt-4 flex justify-end gap-4">
                      <button type="button" data-action="click->app-destroy#close" class="cursor-pointer border border-gray-300 rounded p-2">閉じる</button>
                      <%= f.submit "アプリを削除", class: "bg-cyan-300 text-white font-bold rounded p-2 cursor-pointer" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          <p><%= link_to "アプリを編集", edit_app_path(app) %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
