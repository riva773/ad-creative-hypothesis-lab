<header>
  <div class="flex h-20 items-center justify-between border-b border-slate-800 bg-slate-950 px-6">
    <div class="flex items-center gap-3">
      <%= image_tag "logo.png", class: "h-12 w-12 object-contain" %>
      <span class="text-lg font-semibold tracking-tight text-slate-100">Ad Creative Hypothesis Lab</span>
    </div>
    <div class="flex items-center gap-2 text-sm font-medium">
      <%= link_to "広告結果一覧", ad_tests_results_path, class: "rounded-lg px-3 py-2 text-slate-300 transition hover:bg-slate-800 hover:text-white" %>
      <%= link_to "アプリ一覧", apps_path, class: "rounded-lg px-3 py-2 text-slate-300 transition hover:bg-slate-800 hover:text-white" %>
      <%= link_to "ログアウト", destroy_user_session_path , class: "rounded-lg px-3 py-2 text-slate-400 transition hover:bg-slate-800 hover:text-white", data: { turbo_method: :delete, turbo_confirm: "ログアウトしますか？" } %>
    </div>
  </div>
</header>
