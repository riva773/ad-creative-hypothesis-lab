<div class="mx-auto w-[720px] py-10">
  <div class="mb-7">
    <%= link_to "← アプリ一覧に戻る", apps_path, class: "text-sm font-semibold text-blue-600 transition hover:text-blue-700 hover:underline" %>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">アプリ情報を編集</h1>
    <p class="mt-2 text-sm text-slate-500">アプリ名・アイコン・詳細を変更できます。</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <%= form_with model: @app, class: "space-y-6" do |f| %>
      <% if @app.errors.any? %>
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert">
          <p class="font-semibold">入力内容を確認してください</p>
          <ul class="mt-2 list-inside list-disc space-y-1">
            <% @app.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :avatar, "アプリアイコン", class: "block text-sm font-semibold text-slate-700" %>
        <div class="mt-3 flex items-center gap-4">
          <% if @app.avatar.attached? %>
            <%= image_tag @app.avatar, class: "h-20 w-20 rounded-2xl border border-slate-200 object-cover", alt: "現在のアプリアイコン" %>
          <% else %>
            <%= image_tag "sample_app_logo.png", class: "h-20 w-20 rounded-2xl border border-slate-200 object-cover", alt: "現在のアプリアイコン" %>
          <% end %>
          <div>
            <%= f.file_field :avatar, accept: "image/png,image/jpeg", class: "block cursor-pointer rounded-xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-600 transition hover:border-blue-400 hover:bg-blue-50/40 file:mr-3 file:cursor-pointer file:border-0 file:bg-blue-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-blue-700" %>
          </div>
        </div>
      </div>

      <div>
        <%= f.label :name, "アプリ名", class: "block text-sm font-semibold text-slate-700" %>
        <%= f.text_field :name, class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
      </div>

      <div>
        <%= f.label :explanation, "アプリ詳細", class: "block text-sm font-semibold text-slate-700" %>
        <%= f.text_area :explanation, rows: 6, class: "mt-2 block w-full resize-y rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100", placeholder: "アプリの特徴や用途を入力してください" %>
      </div>

      <div class="flex justify-end gap-3 border-t border-slate-200 pt-6">
        <%= link_to "キャンセル", apps_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-600 transition hover:bg-slate-50 hover:text-slate-900" %>
        <%= f.submit "変更を保存", class: "cursor-pointer rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/30" %>
      </div>
    <% end %>
  </div>
</div>
