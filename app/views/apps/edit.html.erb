<div class="mx-auto max-w-2xl px-4 py-8 sm:py-12">
  <div class="mb-6">
    <%= link_to "← アプリ一覧に戻る", apps_path, class: "text-sm text-cyan-700 hover:text-cyan-900" %>
    <h1 class="mt-2 text-3xl font-bold text-gray-900">アプリ情報を編集</h1>
    <p class="mt-2 text-sm text-gray-500">アプリ名やアイコン、アプリの詳細を変更できます。</p>
  </div>
  <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
    <%= form_with model: @app, class: "space-y-6" do |f| %>
      <% if @app.errors.any? %>
        <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700" role="alert">
          <p class="font-bold">入力内容を確認してください</p>
          <ul class="mt-2 list-inside list-disc">
            <% @app.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :avatar, "アプリアイコン", class: "block text-sm font-bold text-gray-800" %>
        <div class="mt-3 flex items-center gap-4">
          <% if @app.avatar.attached? %>
            <%= image_tag @app.avatar, class: "h-20 w-20 rounded-2xl object-cover", alt: "現在のアプリアイコン" %>
          <% else %>
            <%= image_tag "sample_app_logo.png", class: "h-20 w-20 rounded-2xl object-cover", alt: "現在のアプリアイコン" %>
          <% end %>
          <div>
            <%= f.file_field :avatar, accept: "image/png,image/jpeg", class: "block w-full cursor-pointer rounded-lg border border-gray-300 bg-gray-50 text-sm text-gray-700 file:mr-3 file:bg-cyan-50 file:px-3 file:py-2 file:text-sm file:font-bold file:text-cyan-700 file:cursor-pointer hover:file:bg-cyan-100" %>
          </div>
        </div>
      </div>

      <div>
        <%= f.label :name, "アプリ名", class: "block text-sm font-bold text-gray-800" %>
        <%= f.text_field :name, class: "mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900"%>
      </div>

      <div>
        <%= f.label :explanation, "アプリ詳細", class: "block text-sm font-bold text-gray-800" %>
        <%= f.text_area :explanation, rows: 6, class: "mt-2 block w-full resize-y rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900", placeholder: "アプリの特徴や用途を入力してください" %>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-gray-100 pt-6 sm:flex-row sm:justify-end">
        <%= link_to "キャンセル", apps_path, class: "rounded-lg border border-gray-300 px-4 py-2.5 text-center text-sm font-bold text-gray-600 transition hover:bg-gray-50" %>
        <%= f.submit "変更を保存", class: "cursor-pointer rounded-lg bg-cyan-500 px-4 py-2.5 text-sm font-bold text-white" %>
      </div>
    <% end %>
  </div>
</div>

