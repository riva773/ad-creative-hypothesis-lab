<div class="flex h-[calc(100vh-5rem)] gap-6">
  <div class="w-64 shrink-0 h-full">
    <%= render "shared/side_bar" %>
  </div>
  <div class="min-w-0 max-w-6xl flex-1 pb-10 mr-4">
    <div class="border-b border-sky-200 pb-6 pt-2">
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><%= @app.name %></h1>
      <div class="mt-4 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
          <p class="font-semibold text-slate-700"><%= @app.campaign_name %></p>
          <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-500"><%= @app.explanation %></p>
        </div>
        <div class="flex min-w-20 flex-col rounded-2xl border border-slate-200 bg-blue-900 px-5 py-4 shadow-sm text-center">
          <p class="text-xs font-semibold tracking-[0.12em] text-slate-200">最安CPI</p>
          <% if @ad_tests.minimum(:cpi).present?%>
            <p class="mt-1 text-2xl font-bold text-white"><%= @ad_tests.minimum(:cpi) %>円</p>
          <% else %>
            <p class="mt-1 text-2xl font-bold text-white"><%= @ad_tests.minimum(:cpi) %>ー 円</p>
          <% end %>
        </div>
      </div>
    </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <div data-controller="hypothesis ad-upload hypothesis-management">
          <button data-action="click->hypothesis#open" class="inline-flex cursor-pointer items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100">+ 仮説を追加</button>
          <button data-action="click->hypothesis-management#open" class="ml-2 inline-flex cursor-pointer items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100" >仮説を管理</button>
          <button data-action="click->ad-upload#open" class="ml-2 inline-flex cursor-pointer items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100" >+ 広告をアップロード</button>
          <div data-hypothesis-target="modal" data-action="click@window->hypothesis#closeOutside" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4">
            <div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl ring-1 ring-slate-900/5">
              <div class="flex justify-between items-start">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">仮説を追加</h1>
                <button type="button" data-action="click->hypothesis#close" class="cursor-pointer rounded-lg px-2 py-1 text-2xl leading-none text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="仮説を追加を閉じる">×</button>
              </div>
              <%= form_with model: @hypothesis, class: "flex flex-col" do |f| %>
                <%= f.hidden_field :app_id, value: @app.id %>
                <%= f.label :content, class: "block text-sm font-semibold text-slate-700" %>
                <%= f.text_area :content, placeholder: "例：動画の冒頭に結論を入れると、視聴完了率が上がる", class: "mt-2 h-24 w-full rounded-xl border border-slate-300 p-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
                <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
                  <%= link_to "キャンセル", @app, class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 hover:text-slate-900" %>
                  <%= f.submit "追加", class: "cursor-pointer rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-100" %>
                </div>
              <% end %>
            </div>
          </div>
          <div data-ad-upload-target="modal" data-action="click@window->ad-upload#closeOutside" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4">
            <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl bg-white p-8 shadow-2xl ring-1 ring-slate-900/5">
              <div class="mb-8">
                <div class="flex items-start justify-between">
                  <h1 class="text-2xl font-bold tracking-tight text-slate-900">テスト記録を追加</h1>
                  <button type="button" data-action="click->ad-upload#close" class="cursor-pointer rounded-lg px-2 py-1 text-2xl leading-none text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="広告アップロードを閉じる">×</button>
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                  仮説を選択して、検証する広告動画をアップロードしてください。
                </p>
              </div>
              <%= form_with model: @ad, class: "space-y-6" do |f| %>
                <%= f.hidden_field :app_id, value: @app.id %>
                <div class="space-y-2">
                  <%= f.label :hypothesis, "対象の仮説", class: "block text-sm font-semibold text-slate-700" %>
                  <select name="hypothesis" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100">
                    <%= @untestedHypotheses.each do |hypothesis| %>
                      <option value="<%= hypothesis.id%>"><%= hypothesis.content %></option>
                    <% end %>
                  </select>
                </div>
                <div class="space-y-2">
                  <%= f.label :creative, "広告動画", class: "block text-sm font-semibold text-slate-700" %>
                  <%= f.file_field :creative, class: "block w-full cursor-pointer rounded-xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-500 transition file:mr-4 file:cursor-pointer file:border-0 file:bg-blue-50 file:px-4 file:py-3 file:font-semibold file:text-blue-700 hover:border-blue-400 hover:bg-blue-50/40", accept: "video/mp4"  %>
                  <p class="text-xs text-slate-400">検証対象となる動画ファイルを選択してください。</p>
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-6">
                  <%= link_to "キャンセル", @app, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-700" %>
                  <%= f.submit "ファイルをアップロード", class: "cursor-pointer rounded-xl bg-blue-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-100" %>
                </div>
              <% end %>
            </div>
          </div>
          <div data-hypothesis-management-target="modal" data-action="click@window->hypothesis-management#closeOutside" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4">
            <div class="max-h-[90vh] w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-900/5">
              <div class="flex items-start justify-between border-b border-slate-100 px-6 py-5">
                <div>
                  <h2 class="text-2xl font-bold tracking-tight text-slate-900">仮説を管理</h2>
                  <p class="mt-2 text-sm leading-6 text-slate-500">未使用の仮説を確認し、編集、削除を行えます。</p>
                </div>
                <button type="button" data-action="click->hypothesis-management#close" class="cursor-pointer rounded-lg px-2 py-1 text-2xl leading-none text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="仮説管理を閉じる">×</button>
              </div>
              <div class="max-h-[480px] overflow-y-auto p-6">
                <% if @untestedHypotheses.present? %>
                  <div class="space-y-3">
                    <% @untestedHypotheses.each do |hypothesis| %>
                      <div class="flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-blue-200 hover:bg-blue-50/30">
                        <div class="min-w-0">
                          <%= form_with model: hypothesis do |f| %>
                            <%= f.text_field :content, class: "w-full break-words text-sm font-semibold leading-6 text-slate-800 outline-none focus:text-blue-700" %>
                        </div>
                        <div >
                          <%= f.submit "更新", class: "cursor-pointer rounded-lg bg-blue-700 px-3 py-2 text-sm font-semibold text-white transition hover:bg-blue-800" %>
                          <% end %>
                          <%= link_to "削除", hypothesis_path(hypothesis), data: { turbo_method: :delete, turbo_confirm: "この仮説を削除しますか？" }, class: "rounded-lg bg-rose-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-rose-700" %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
                    <p class="font-semibold text-slate-700">まだ仮説がありません</p>
                    <p class="mt-2 text-sm text-slate-500">仮説を追加すると、管理できます。</p>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div data-controller="csv">
          <button data-action="click->csv#open" class="inline-flex cursor-pointer items-center rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-100">CSVを取り込む</button>
          <div data-csv-target="modal" data-action="click@window->csv#closeOutside" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4">
            <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl bg-white p-8 shadow-2xl ring-1 ring-slate-900/5">
              <div class="mb-8">
                <div class="flex items-start justify-between">
                  <h1 class="text-2xl font-bold tracking-tight text-slate-900">CSVを取り込む</h1>
                  <button type="button" data-action="click->csv#close" class="cursor-pointer rounded-lg px-2 py-1 text-2xl leading-none text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="CSV取り込みを閉じる">×</button>
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                  テスト結果が記載されたCSVファイルを選択してください。
                </p>
              </div>
              <%= form_with url: ad_tests_path, scope: :ad_test, multipart: true, class: "space-y-6" do |f| %>
                <%= f.hidden_field :app_id, value: @app.id %>
                <div class="space-y-2">
                  <%= f.label :network, class: "block text-sm font-semibold text-slate-700" %>
                  <%= f.select :network, ["Meta", "Google", "AppLovin"], include_blank: "選択してください", class: "w-full rounded-xl border-2 border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-700 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
                  <%= f.label :csv, "CSVファイル", class: "mt-2 block text-sm font-semibold text-slate-700" %>
                  <%= f.file_field :csv, accept: ".csv,text/csv", class: "block w-full cursor-pointer rounded-xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-500 transition file:mr-4 file:cursor-pointer file:border-0 file:bg-blue-50 file:px-4 file:py-3 file:font-semibold file:text-blue-700 hover:border-blue-400 hover:bg-blue-50/40", required: true %>
                  <p class="text-xs text-slate-400">CSV形式のファイルを選択してください。</p>
                </div>
                <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-6">
                  <button type="button" data-action="click->csv#close" class="cursor-pointer rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-700">キャンセル</button>
                  <%= f.submit "CSVを取り込む", class: "cursor-pointer rounded-xl bg-blue-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-100" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <%= render "shared/test_index", app: @app, ad_tests: @ad_tests, hypotheses_count: @untestedHypotheses.count %>
  </main>
</div>
